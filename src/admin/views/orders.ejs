<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FF STORE - Orders</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&display=swap');
    :root {
      --bg: #01040a; --card-bg: #050b16; --border: #0d2438;
      --neon: #00f6ff; --neon-glow: rgba(0, 246, 255, 0.45);
      --text: #eaf9ff; --muted: #4d6b7a;
      --success: #00ff9d; --warn: #ffd60a; --danger: #ff2d55;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'JetBrains Mono', monospace; background: var(--bg);
      background-image:
        radial-gradient(circle at 50% 0%, rgba(0, 246, 255, 0.12) 0%, transparent 65%),
        linear-gradient(rgba(0, 246, 255, 0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 246, 255, 0.07) 1px, transparent 1px);
      background-size: 100% 100%, 28px 28px, 28px 28px;
      color: var(--text); padding: 30px clamp(15px, 4vw, 50px); min-height: 100vh;
    }
    body::after { content: " "; position: fixed; inset: 0;
      background: linear-gradient(rgba(0,0,0,0) 50%, rgba(0, 246, 255, 0.035) 50%);
      background-size: 100% 4px; z-index: 99; pointer-events: none; }

    .header-area { display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 25px; border-bottom: 1px solid var(--border); padding-bottom: 20px; flex-wrap: wrap; gap: 12px; }
    h1 { font-size: 22px; font-weight: 800; color: var(--neon); text-transform: uppercase;
      letter-spacing: 2px; text-shadow: 0 0 8px var(--neon), 0 0 26px var(--neon-glow); }
    a.back-link { color: var(--muted); text-decoration: none; font-size: 12px; background: var(--card-bg);
      padding: 8px 14px; border-radius: 6px; border: 1px solid var(--border); transition: all 0.2s; }
    a.back-link:hover { color: var(--neon); border-color: var(--neon); box-shadow: 0 0 12px var(--neon-glow); }

    .filter-bar { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
    .filter-bar a { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--muted);
      border: 1px solid var(--border); padding: 7px 14px; border-radius: 20px; text-decoration: none; transition: all 0.2s; }
    .filter-bar a.active, .filter-bar a:hover { color: var(--neon); border-color: var(--neon);
      box-shadow: 0 0 6px var(--neon), 0 0 16px var(--neon-glow); }

    .table-wrap { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px;
      overflow-x: auto; box-shadow: 0 0 35px rgba(0, 246, 255, 0.12); position: relative; }
    .table-wrap::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, transparent, var(--neon), transparent); box-shadow: 0 0 10px var(--neon); opacity: 0.7; }
    table { width: 100%; border-collapse: collapse; font-size: 12.5px; min-width: 700px; }
    th { background: #06121f; color: var(--neon); text-transform: uppercase; letter-spacing: 1px;
      font-size: 10.5px; padding: 12px 14px; text-align: left; border-bottom: 1px solid var(--border);
      text-shadow: 0 0 8px rgba(0,246,255,0.4); }
    td { padding: 12px 14px; border-bottom: 1px solid #0a1a2a; color: #cbd5e1; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: rgba(0, 246, 255, 0.06); }

    .badge { font-size: 10px; padding: 4px 10px; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.5px; }
    .badge-delivered, .badge-completed { background: rgba(0,255,157,0.12); color: var(--success); border: 1px solid #00b374; text-shadow: 0 0 6px rgba(0,255,157,0.5); }
    .badge-pending, .badge-payment_verified { background: rgba(255,214,10,0.12); color: var(--warn); border: 1px solid #cca700; text-shadow: 0 0 6px rgba(255,214,10,0.5); }
    .badge-failed, .badge-expired, .badge-cancelled { background: rgba(255,45,85,0.12); color: var(--danger); border: 1px solid #cc1440; text-shadow: 0 0 6px rgba(255,45,85,0.5); }
    .empty-state { text-align: center; padding: 40px; color: var(--muted); font-size: 13px; }
  </style>
</head>
<body>
  <div class="header-area">
    <h1>📋 Orders</h1>
    <a href="/admin/dashboard" class="back-link">← Back to Dashboard</a>
  </div>

  <div class="filter-bar">
    <a href="/admin/orders?filter=ALL" class="<%= filter === 'ALL' ? 'active' : '' %>">All</a>
    <a href="/admin/orders?filter=PENDING" class="<%= filter === 'PENDING' ? 'active' : '' %>">Pending</a>
    <a href="/admin/orders?filter=PAYMENT_VERIFIED" class="<%= filter === 'PAYMENT_VERIFIED' ? 'active' : '' %>">Payment Verified</a>
    <a href="/admin/orders?filter=DELIVERED" class="<%= filter === 'DELIVERED' ? 'active' : '' %>">Delivered</a>
    <a href="/admin/orders?filter=COMPLETED" class="<%= filter === 'COMPLETED' ? 'active' : '' %>">Completed</a>
    <a href="/admin/orders?filter=EXPIRED" class="<%= filter === 'EXPIRED' ? 'active' : '' %>">Expired</a>
    <a href="/admin/orders?filter=CANCELLED" class="<%= filter === 'CANCELLED' ? 'active' : '' %>">Cancelled</a>
  </div>

  <div class="table-wrap">
    <table>
      <tr><th>Order ID</th><th>User</th><th>Product</th><th>Plan</th><th>Amount</th><th>Status</th><th>Date</th></tr>
      <% if (orders.length === 0) { %>
        <tr><td colspan="7" class="empty-state">No orders found for this filter.</td></tr>
      <% } else { %>
        <% orders.forEach(order => { %>
          <tr>
            <td><%= order.id.slice(0,8) %></td>
            <td>@<%= order.user.username || order.user.telegramId.toString() %></td>
            <td><%= order.product.name %></td>
            <td><%= order.plan.durationLabel %></td>
            <td>₹<%= order.amount %></td>
            <td><span class="badge badge-<%= order.status.toLowerCase() %>"><%= order.status %></span></td>
            <td><%= order.createdAt.toISOString().slice(0,16).replace('T',' ') %></td>
          </tr>
        <% }) %>
      <% } %>
    </table>
  </div>
</body>
</html>
