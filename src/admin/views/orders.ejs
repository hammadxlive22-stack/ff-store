<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FF STORE - Orders</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&display=swap');

    :root {
      --bg: #030712; --card-bg: #090d16; --border: #1e293b;
      --neon: #38bdf8; --neon-glow: rgba(56, 189, 248, 0.25);
      --text: #f8fafc; --muted: #64748b;
      --success: #34d399; --warn: #fbbf24; --danger: #f87171;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'JetBrains Mono', monospace;
      background: var(--bg);
      background-image:
        radial-gradient(circle at 50% 0%, rgba(14, 165, 233, 0.07) 0%, transparent 65%),
        linear-gradient(rgba(15, 23, 42, 0.4) 1px, transparent 1px),
        linear-gradient(90deg, rgba(15, 23, 42, 0.4) 1px, transparent 1px);
      background-size: 100% 100%, 35px 35px, 35px 35px;
      color: var(--text);
      padding: 30px clamp(15px, 4vw, 50px);
      min-height: 100vh;
    }
    .header-area {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 25px; border-bottom: 1px solid var(--border); padding-bottom: 20px;
      flex-wrap: wrap; gap: 12px;
    }
    h1 { font-size: 22px; font-weight: 800; color: var(--neon); text-transform: uppercase;
      letter-spacing: 2px; text-shadow: 0 0 12px var(--neon-glow); }
    a.back-link {
      color: var(--muted); text-decoration: none; font-size: 12px; background: var(--card-bg);
      padding: 8px 14px; border-radius: 6px; border: 1px solid var(--border); transition: all 0.2s;
    }
    a.back-link:hover { color: var(--neon); border-color: var(--neon); }

    .filter-bar { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
    .filter-bar a {
      font-size: 11px; text-transform: uppercase; letter-spacing: 1px;
      color: var(--muted); border: 1px solid var(--border); padding: 7px 14px;
      border-radius: 20px; text-decoration: none; transition: all 0.2s;
    }
    .filter-bar a.active, .filter-bar a:hover { color: var(--neon); border-color: var(--neon); box-shadow: 0 0 10px var(--neon-glow); }

    .table-wrap {
      background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px;
      overflow-x: auto; box-shadow: 0 0 25px rgba(14, 165, 233, 0.08);
    }
    table { width: 100%; border-collapse: collapse; font-size: 12.5px; min-width: 700px; }
    th {
      background: #0f172a; color: var(--neon); text-transform: uppercase; letter-spacing: 1px;
      font-size: 10.5px; padding: 12px 14px; text-align: left; border-bottom: 1px solid var(--border);
    }
    td { padding: 12px 14px; border-bottom: 1px solid #0f172a; color: #cbd5e1; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: rgba(56, 189, 248, 0.04); }

    .badge { font-size: 10px; padding: 4px 10px; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.5px; }
    .badge-delivered, .badge-completed { background: rgba(52,211,153,0.12); color: var(--success); border: 1px solid #059669; }
    .badge-pending, .badge-payment_verified { background: rgba(251,191,36,0.12); color: var(--warn); border: 1px solid #d97706; }
    .badge-failed, .badge-expired, .badge-cancelled { background: rgba(248,113,113,0.12); color: var(--danger); border: 1px solid #dc2626; }
    .empty-state { text-align: center; padding: 40px; color: var(--muted); font-size: 13px; }
  </style>
</head>
<body>
  <div class="header-area">
    <h1>📋 Orders</h1>
    <a href="/admin/dashboard" class="back-link">← Back to Dashboard</a>
  </div>

  <div class="filter-bar">
    <a href="/admin/orders?filter=ALL" class="<%= filter === 'ALL' ? 'active' : '' %>">All</a>
    <a href="/admin/orders?filter=PENDING" class="<%= filter === 'PENDING' ? 'active' : '' %>">Pending</a>
    <a href="/admin/orders?filter=PAYMENT_VERIFIED" class="<%= filter === 'PAYMENT_VERIFIED' ? 'active' : '' %>">Payment Verified</a>
    <a href="/admin/orders?filter=DELIVERED" class="<%= filter === 'DELIVERED' ? 'active' : '' %>">Delivered</a>
    <a href="/admin/orders?filter=COMPLETED" class="<%= filter === 'COMPLETED' ? 'active' : '' %>">Completed</a>
    <a href="/admin/orders?filter=EXPIRED" class="<%= filter === 'EXPIRED' ? 'active' : '' %>">Expired</a>
    <a href="/admin/orders?filter=CANCELLED" class="<%= filter === 'CANCELLED' ? 'active' : '' %>">Cancelled</a>
  </div>

  <div class="table-wrap">
    <table>
      <tr>
        <th>Order ID</th><th>User</th><th>Product</th><th>Plan</th>
        <th>Amount</th><th>Status</th><th>Date</th>
      </tr>
      <% if (orders.length === 0) { %>
        <tr><td colspan="7" class="empty-state">No orders found for this filter.</td></tr>
      <% } else { %>
        <% orders.forEach(order => { %>
          <tr>
            <td><%= order.id.slice(0,8) %></td>
            <td>@<%= order.user.username || order.user.telegramId.toString() %></td>
            <td><%= order.product.name %></td>
            <td><%= order.plan.durationLabel %></td>
            <td>₹<%= order.amount %></td>
            <td><span class="badge badge-<%= order.status.toLowerCase() %>"><%= order.status %></span></td>
            <td><%= order.createdAt.toISOString().slice(0,16).replace('T',' ') %></td>
          </tr>
        <% }) %>
      <% } %>
    </table>
  </div>
</body>
</html>
