<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FF STORE - Hacker Admin Login</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&display=swap');

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'JetBrains Mono', monospace;
      background: #09090e;
      background-image: 
        radial-gradient(circle at 50% 50%, rgba(255, 137, 6, 0.05) 0%, transparent 60%),
        linear-gradient(rgba(15, 14, 23, 0.8) 1px, transparent 1px),
        linear-gradient(90deg, rgba(15, 14, 23, 0.8) 1px, transparent 1px);
      background-size: 100% 100%, 30px 30px, 30px 30px;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      color: #fffffe;
      overflow: hidden;
    }

    .login-container {
      position: relative;
      width: 400px;
      padding: 4px;
      border-radius: 14px;
      background: linear-gradient(135deg, #ff8906, #f25f4c, #0f0e17);
      box-shadow: 0 0 35px rgba(255, 137, 6, 0.2);
      animation: borderGlow 4s ease infinite alternate;
    }

    @keyframes borderGlow {
      0% { box-shadow: 0 0 20px rgba(255, 137, 6, 0.2); }
      100% { box-shadow: 0 0 45px rgba(242, 95, 76, 0.4); }
    }

    .login-box {
      background: #121118;
      padding: 40px 35px;
      border-radius: 12px;
      text-align: left;
    }

    .logo-area {
      text-align: center;
      margin-bottom: 30px;
    }

    .logo-area h1 {
      font-size: 26px;
      font-weight: 800;
      letter-spacing: 2px;
      color: #ff8906;
      text-transform: uppercase;
      text-shadow: 0 0 10px rgba(255, 137, 6, 0.4);
    }

    .logo-area p {
      font-size: 12px;
      color: #a7a9be;
      margin-top: 5px;
      letter-spacing: 1px;
    }

    .input-group {
      margin-bottom: 20px;
    }

    .input-group label {
      display: block;
      font-size: 12px;
      color: #a7a9be;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    input {
      width: 100%;
      padding: 14px 16px;
      background: #1a1a24;
      border: 1px solid #2e2f3e;
      border-radius: 8px;
      color: #fffffe;
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      transition: all 0.3s ease;
    }

    input:focus {
      outline: none;
      border-color: #ff8906;
      background: #1e1d29;
      box-shadow: 0 0 12px rgba(255, 137, 6, 0.25);
    }

    button {
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, #ff8906, #f25f4c);
      color: #0f0e17;
      border: none;
      border-radius: 8px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 15px;
      font-weight: 800;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-top: 10px;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(255, 137, 6, 0.3);
    }

    button:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(255, 137, 6, 0.5);
      filter: brightness(1.1);
    }

    button:active {
      transform: translateY(1px);
    }

    .error {
      background: rgba(242, 95, 76, 0.1);
      border-left: 3px solid #f25f4c;
      color: #f25f4c;
      padding: 10px 14px;
      border-radius: 4px;
      font-size: 13px;
      margin-bottom: 20px;
      text-align: left;
    }

    .terminal-footer {
      text-align: center;
      margin-top: 25px;
      font-size: 11px;
      color: #56556b;
      letter-spacing: 1px;
    }
  </style>
</head>
<body>

  <div class="login-container">
    <div class="login-box">
      <div class="logo-area">
        <h1>💻 FF STORE</h1>
        <p>[ SECURE ADMIN PORTAL ]</p>
      </div>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form method="POST" action="/admin/login">
        <div class="input-group">
          <label>Username</label>
          <input type="text" name="username" placeholder="Enter admin username" required autocomplete="off">
        </div>

        <div class="input-group">
          <label>Password</label>
          <input type="password" name="password" placeholder="••••••••••••" required>
        </div>

        <button type="submit">Authenticate ⚡</button>
      </form>

      <div class="terminal-footer">
        ACCESS RESTRICTED // 256-BIT ENCRYPTION
      </div>
    </div>
  </div>

</body>
</html>
