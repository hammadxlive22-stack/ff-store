<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FF STORE - Secure Terminal</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&display=swap');

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'JetBrains Mono', monospace;
      background: #030712;
      background-image: 
        radial-gradient(circle at 50% 50%, rgba(14, 165, 233, 0.08) 0%, transparent 70%),
        linear-gradient(rgba(15, 23, 42, 0.5) 1px, transparent 1px),
        linear-gradient(90deg, rgba(15, 23, 42, 0.5) 1px, transparent 1px);
      background-size: 100% 100%, 35px 35px, 35px 35px;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      color: #f8fafc;
      overflow: hidden;
    }

    /* Subtle scanning line overlay */
    body::after {
      content: " ";
      display: block;
      position: fixed;
      top: 0; left: 0; bottom: 0; right: 0;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.15) 50%);
      background-size: 100% 4px;
      z-index: 99;
      pointer-events: none;
    }

    .login-container {
      position: relative;
      width: 420px;
      padding: 3px;
      border-radius: 16px;
      background: linear-gradient(135deg, #0ea5e9, #3b82f6, #1e1b4b);
      box-shadow: 0 0 50px rgba(14, 165, 233, 0.25), inset 0 0 15px rgba(59, 130, 246, 0.2);
      animation: borderPulse 4s ease infinite alternate;
    }

    @keyframes borderPulse {
      0% { box-shadow: 0 0 30px rgba(14, 165, 233, 0.2), inset 0 0 10px rgba(14, 165, 233, 0.1); }
      100% { box-shadow: 0 0 60px rgba(59, 130, 246, 0.45), inset 0 0 20px rgba(59, 130, 246, 0.3); }
    }

    .login-box {
      background: #090d16;
      padding: 45px 38px;
      border-radius: 14px;
      text-align: left;
    }

    .logo-area {
      text-align: center;
      margin-bottom: 35px;
    }

    .logo-area h1 {
      font-size: 28px;
      font-weight: 800;
      letter-spacing: 3px;
      color: #38bdf8;
      text-transform: uppercase;
      text-shadow: 0 0 15px rgba(56, 189, 248, 0.6);
    }

    .logo-area p {
      font-size: 11px;
      color: #64748b;
      margin-top: 8px;
      letter-spacing: 2px;
    }

    .input-group {
      margin-bottom: 22px;
    }

    .input-group label {
      display: block;
      font-size: 11px;
      color: #94a3b8;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }

    input {
      width: 100%;
      padding: 14px 16px;
      background: #0f172a;
      border: 1px solid #1e293b;
      border-radius: 8px;
      color: #f1f5f9;
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      transition: all 0.3s ease;
    }

    input:focus {
      outline: none;
      border-color: #38bdf8;
      background: #111e38;
      box-shadow: 0 0 15px rgba(56, 189, 248, 0.3);
    }

    button {
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, #0ea5e9, #2563eb);
      color: #ffffff;
      border: none;
      border-radius: 8px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-top: 12px;
      transition: all 0.3s ease;
      box-shadow: 0 4px 20px rgba(14, 165, 233, 0.4);
    }

    button:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 25px rgba(14, 165, 233, 0.7);
      background: linear-gradient(135deg, #38bdf8, #1d4ed8);
    }

    button:active {
      transform: translateY(1px);
    }

    .error {
      background: rgba(239, 68, 68, 0.1);
      border-left: 3px solid #ef4444;
      color: #f87171;
      padding: 12px 14px;
      border-radius: 6px;
      font-size: 12px;
      margin-bottom: 22px;
      text-align: left;
      box-shadow: inset 0 0 10px rgba(239, 68, 68, 0.1);
    }

    .terminal-footer {
      text-align: center;
      margin-top: 30px;
      font-size: 10px;
      color: #475569;
      letter-spacing: 1.5px;
    }
  </style>
</head>
<body>

  <div class="login-container">
    <div class="login-box">
      <div class="logo-area">
        <h1>⚡ FF STORE</h1>
        <p>[ SECURE NODE TERMINAL ]</p>
      </div>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form method="POST" action="/admin/login">
        <div class="input-group">
          <label>Username</label>
          <input type="text" name="username" placeholder="Enter operator id" required autocomplete="off">
        </div>

        <div class="input-group">
          <label>Password</label>
          <input type="password" name="password" placeholder="••••••••••••" required>
        </div>

        <button type="submit">Initialize Link // ⚡</button>
      </form>

      <div class="terminal-footer">
        STATUS: ONLINE // ENCRYPTION: SHA-256
      </div>
    </div>
  </div>

</body>
</html>
