<!DOCTYPE html>
<html>
<head>
  <title>FF STORE - Admin Login</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: Arial, sans-serif;
      background: #1a1a2e;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }
    .login-box {
      background: #16213e;
      padding: 40px;
      border-radius: 10px;
      width: 350px;
    }
    h1 { color: #e94560; text-align: center; margin-bottom: 30px; }
    input {
      width: 100%;
      padding: 12px;
      margin: 10px 0;
      background: #0f3460;
      border: 1px solid #e94560;
      border-radius: 5px;
      color: white;
    }
    button {
      width: 100%;
      padding: 12px;
      background: #e94560;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      margin-top: 20px;
    }
    button:hover { background: #ff6b81; }
    .error { color: #ff4757; text-align: center; margin: 10px 0; }
  </style>
</head>
<body>
  <div class="login-box">
    <h1>👑 FF STORE</h1>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <form method="POST" action="/admin/login">
      <input type="text" name="username" placeholder="Username" required>
      <input type="password" name="password" placeholder="Password" required>
      <button type="submit">Login</button>
    </form>
  </div>
</body>
</html>