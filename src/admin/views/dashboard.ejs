<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FF STORE - Admin Dashboard</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&display=swap');

    :root {
      --bg: #030712;
      --card-bg: #090d16;
      --border: #1e293b;
      --neon: #38bdf8;
      --neon-glow: rgba(56, 189, 248, 0.25);
      --text: #f8fafc;
      --muted: #64748b;
      --danger: #f87171;
      --success: #34d399;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'JetBrains Mono', monospace;
      background: var(--bg);
      background-image:
        radial-gradient(circle at 50% 0%, rgba(14, 165, 233, 0.07) 0%, transparent 65%),
        linear-gradient(rgba(15, 23, 42, 0.4) 1px, transparent 1px),
        linear-gradient(90deg, rgba(15, 23, 42, 0.4) 1px, transparent 1px);
      background-size: 100% 100%, 35px 35px, 35px 35px;
      color: var(--text);
      min-height: 100vh;
      padding: 30px clamp(15px, 4vw, 50px);
    }

    body::after {
      content: " ";
      position: fixed;
      inset: 0;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.12) 50%);
      background-size: 100% 4px;
      z-index: 99;
      pointer-events: none;
    }

    .header-area {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 20px;
      flex-wrap: wrap;
      gap: 15px;
    }

    h1 {
      font-size: 22px;
      font-weight: 800;
      color: var(--neon);
      text-transform: uppercase;
      letter-spacing: 2px;
      text-shadow: 0 0 12px var(--neon-glow);
    }

    .status-pill {
      font-size: 11px;
      color: var(--success);
      border: 1px solid var(--success);
      padding: 5px 12px;
      border-radius: 20px;
      letter-spacing: 1px;
    }
    .status-pill::before { content: '● '; }

    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 18px;
      margin-bottom: 35px;
    }

    .stat-card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      padding: 20px;
      border-radius: 12px;
      text-align: center;
      box-shadow: 0 0 20px rgba(14, 165, 233, 0.06);
      transition: all 0.25s ease;
    }
    .stat-card:hover {
      border-color: var(--neon);
      box-shadow: 0 0 20px var(--neon-glow);
      transform: translateY(-3px);
    }

    .stat-value {
      font-size: 26px;
      font-weight: 800;
      color: var(--neon);
      text-shadow: 0 0 10px var(--neon-glow);
    }

    .stat-label {
      font-size: 11px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-top: 6px;
    }

    h2.section-title {
      font-size: 13px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 15px;
      border-left: 3px solid var(--neon);
      padding-left: 8px;
    }

    .nav-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 14px;
    }

    .nav-btn {
      background: var(--card-bg);
      border: 1px solid var(--border);
      padding: 18px;
      border-radius: 10px;
      text-align: center;
      color: var(--text);
      text-decoration: none;
      font-weight: 700;
      font-size: 13px;
      letter-spacing: 0.5px;
      transition: all 0.2s ease;
    }

    .nav-btn:hover {
      border-color: var(--neon);
      background: #0f172a;
      color: var(--neon);
      box-shadow: 0 0 18px var(--neon-glow);
      transform: translateY(-2px);
    }

    .nav-btn.logout {
      border-color: rgba(239, 68, 68, 0.4);
      color: var(--danger);
    }
    .nav-btn.logout:hover {
      border-color: var(--danger);
      color: var(--danger);
      box-shadow: 0 0 18px rgba(239, 68, 68, 0.3);
    }
  </style>
</head>
<body>

  <div class="header-area">
    <h1>💻 FF Store — Control Panel</h1>
    <span class="status-pill">System Online</span>
  </div>

  <div class="stats">
    <div class="stat-card">
      <div class="stat-value"><%= totalOrders %></div>
      <div class="stat-label">Total Orders</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">₹<%= totalSales %></div>
      <div class="stat-label">Total Sales</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= totalUsers %></div>
      <div class="stat-label">Total Users</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= pendingOrders %></div>
      <div class="stat-label">Pending Orders</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= completedOrders %></div>
      <div class="stat-label">Completed</div>
    </div>
  </div>

  <h2 class="section-title">Navigation</h2>
  <div class="nav-grid">
    <a href="/admin/products" class="nav-btn">🛒 Products & PIDs</a>
    <a href="/admin/orders" class="nav-btn">📋 Orders</a>
    <a href="/admin/users" class="nav-btn">👤 Users</a>
    <a href="/admin/settings" class="nav-btn">⚙️ Settings (APK & Channel)</a>
    <a href="/admin/logs" class="nav-btn">📜 Audit Logs</a>
    <a href="/admin/emojis" class="nav-btn">✨ Custom Emojis</a>
    <a href="/admin/change-password" class="nav-btn">🔑 Change Password</a>
    <a href="/admin/logout" class="nav-btn logout">🚪 Logout</a>
  </div>

</body>
</html>
