<!DOCTYPE html>
<html>
<head>
  <title>FF STORE - Hacker Admin Dashboard</title>
  <style>
    body { font-family: 'Courier New', Courier, monospace; background: #0f0e17; color: #fffffe; padding: 20px; }
    h1 { color: #ff8906; text-shadow: 0 0 10px rgba(255,137,6,0.5); }
    .nav-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin: 20px 0; }
    .nav-btn { background: #2e2f3e; border: 1px solid #ff8906; padding: 15px; border-radius: 8px; text-align: center; color: #fffffe; text-decoration: none; font-weight: bold; transition: 0.2s; }
    .nav-btn:hover { background: #ff8906; color: #0f0e17; box-shadow: 0 0 15px #ff8906; }
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; margin: 20px 0; }
    .stat-card { background: #16161a; border: 1px solid #2e2f3e; padding: 20px; border-radius: 10px; text-align: center; }
    .stat-value { font-size: 24px; color: #f25f4c; font-weight: bold; }
  </style>
</head>
<body>
  <h1>💻 HACKER ADMIN CONTROL PANEL</h1>
  
  <div class="nav-grid">
    <a href="/admin/products" class="nav-btn">🛒 Manage Products & PIDs</a>
    <a href="/admin/search-user" class="nav-btn">👤 Search User by Telegram ID</a>
    <a href="/admin/delivery-logs" class="nav-btn">📜 Live Key Delivery Logs</a>
    <a href="/admin/settings" class="nav-btn">⚙️ Setup APK & Channel Links</a>
    <a href="/admin/change-password" class="nav-btn">🔑 Change Admin Password</a>
    <a href="/admin/emojis" class="nav-btn">✨ Emojis</a>
    <a href="/admin/logout" class="nav-btn" style="border-color: #f25f4c; color: #f25f4c;">🚪 Logout</a>
  </div>

  <div class="stats">
    <div class="stat-card">
      <div class="stat-value"><%= totalOrders %></div>
      <div>Total Orders</div>
    </div>
    <div class="stat-card">
      <div class="stat-value">₹<%= totalSales %></div>
      <div>Total Sales</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= totalUsers %></div>
      <div>Total Users</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= pendingOrders %></div>
      <div>Pending Orders</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= completedOrders %></div>
      <div>Completed</div>
    </div>
  </div>
</body>
</html>
