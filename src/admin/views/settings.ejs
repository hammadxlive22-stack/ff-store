<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FF STORE - Settings</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&display=swap');
    :root {
      --bg: #01040a; --card-bg: #050b16; --border: #0d2438;
      --neon: #00f6ff; --neon-glow: rgba(0, 246, 255, 0.45);
      --text: #eaf9ff; --muted: #4d6b7a; --success: #00ff9d; --danger: #ff2d55;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'JetBrains Mono', monospace; background: var(--bg);
      background-image:
        radial-gradient(circle at 50% 0%, rgba(0, 246, 255, 0.12) 0%, transparent 65%),
        linear-gradient(rgba(0, 246, 255, 0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 246, 255, 0.07) 1px, transparent 1px);
      background-size: 100% 100%, 28px 28px, 28px 28px;
      color: var(--text); padding: 30px clamp(15px, 4vw, 50px); min-height: 100vh;
    }
    body::after { content: " "; position: fixed; inset: 0;
      background: linear-gradient(rgba(0,0,0,0) 50%, rgba(0, 246, 255, 0.035) 50%);
      background-size: 100% 4px; z-index: 99; pointer-events: none; }

    .header-area { display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 25px; border-bottom: 1px solid var(--border); padding-bottom: 20px; flex-wrap: wrap; gap: 12px; }
    h1 { font-size: 22px; font-weight: 800; color: var(--neon); text-transform: uppercase;
      letter-spacing: 2px; text-shadow: 0 0 8px var(--neon), 0 0 26px var(--neon-glow); }
    a.back-link { color: var(--muted); text-decoration: none; font-size: 12px; background: var(--card-bg);
      padding: 8px 14px; border-radius: 6px; border: 1px solid var(--border); transition: all 0.2s; }
    a.back-link:hover { color: var(--neon); border-color: var(--neon); box-shadow: 0 0 12px var(--neon-glow); }

    .alert { padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-size: 13px; max-width: 520px; }
    .alert-success { background: rgba(0,255,157,0.08); color: var(--success); border: 1px solid #00b374; text-shadow: 0 0 8px rgba(0,255,157,0.4); }
    .alert-error { background: rgba(255,45,85,0.08); color: var(--danger); border: 1px solid #cc1440; text-shadow: 0 0 8px rgba(255,45,85,0.4); }

    .card { background: var(--card-bg); border: 1px solid var(--border); padding: 28px; border-radius: 12px;
      max-width: 520px; box-shadow: 0 0 35px rgba(0, 246, 255, 0.12); position: relative; overflow: hidden; }
    .card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, transparent, var(--neon), transparent);
      box-shadow: 0 0 12px var(--neon); animation: scan 2.4s linear infinite; }
    @keyframes scan { 0%,100% { opacity: 0.4; } 50% { opacity: 1; } }

    .form-group { margin-bottom: 22px; }
    label { display: block; font-size: 11px; color: var(--muted); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1.5px; }
    input { width: 100%; padding: 13px 14px; background: #030a14; border: 1px solid var(--border);
      border-radius: 6px; color: var(--neon); font-family: inherit; font-size: 13px; outline: none; transition: all 0.2s; }
    input:focus { border-color: var(--neon); box-shadow: 0 0 4px var(--neon), 0 0 18px var(--neon-glow); }
    button { padding: 13px 22px; background: transparent; border: 1px solid var(--neon); color: var(--neon);
      border-radius: 6px; font-family: inherit; font-weight: 800; font-size: 13px; text-transform: uppercase;
      letter-spacing: 1.5px; cursor: pointer; width: 100%; transition: all 0.2s; }
    button:hover { background: var(--neon); color: #01040a; box-shadow: 0 0 10px var(--neon), 0 0 35px var(--neon-glow); }
    .hint { font-size: 11px; color: var(--muted); margin-top: 20px; line-height: 1.6; }
  </style>
</head>
<body>
  <div class="header-area">
    <h1>⚙️ Settings</h1>
    <a href="/admin/dashboard" class="back-link">← Back to Dashboard</a>
  </div>

  <% if (error) { %><div class="alert alert-error">⚠ <%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success">✔ <%= success %></div><% } %>

  <div class="card">
    <form method="POST" action="/admin/settings">
      <div class="form-group">
        <label>&gt; Support Channel Link</label>
        <input type="text" name="supportUrl" placeholder="https://t.me/yourchannel" value="<%= settings.SUPPORT_CHANNEL_LINK || '' %>">
      </div>
      <div class="form-group">
        <label>&gt; APK Download Link</label>
        <input type="text" name="apkUrl" placeholder="https://yoursite.com/app.apk" value="<%= settings.APK_DOWNLOAD_LINK || '' %>">
      </div>
      <button type="submit">Save Settings</button>
    </form>
    <div class="hint">
      // These links are shown to customers by the bot — the support channel appears after key delivery,
      the APK link is sent via the /apk or related bot command.
    </div>
  </div>
</body>
</html>
