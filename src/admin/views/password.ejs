<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change Password - FF STORE</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=JetBrains+Mono:wght@400;700;800&display=swap');

        :root {
            --bg-color: #01040a;
            --card-bg: #050a14;
            --border-color: #0d2438;
            --neon-blue: #00f6ff;
            --neon-blue-dim: #0aa8c2;
            --neon-glow: rgba(0, 246, 255, 0.35);
            --text-main: #eaf9ff;
            --text-muted: #4d6b7a;
            --error-color: #ff2d55;
            --success-color: #00ff9d;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Share Tech Mono', 'Courier New', monospace;
            background-color: var(--bg-color);
            background-image:
                radial-gradient(circle at 50% 20%, rgba(0, 246, 255, 0.10) 0%, transparent 55%),
                linear-gradient(rgba(0, 246, 255, 0.06) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 246, 255, 0.06) 1px, transparent 1px);
            background-size: 100% 100%, 26px 26px, 26px 26px;
            color: var(--text-main);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

        /* CRT scanline overlay */
        body::after {
            content: "";
            position: fixed;
            inset: 0;
            background: linear-gradient(rgba(0,0,0,0) 50%, rgba(0, 246, 255, 0.035) 50%);
            background-size: 100% 4px;
            pointer-events: none;
            z-index: 5;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            padding: 40px 35px;
            border-radius: 10px;
            width: 100%;
            max-width: 410px;
            box-shadow: 0 0 12px var(--neon-glow), 0 0 60px rgba(0, 246, 255, 0.15), inset 0 0 50px rgba(0, 246, 255, 0.04);
            position: relative;
            animation: fadeIn 0.4s ease;
            z-index: 10;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--neon-blue), transparent);
            box-shadow: 0 0 12px var(--neon-blue);
            animation: scan 2.4s linear infinite;
        }

        @keyframes scan {
            0%, 100% { opacity: 0.35; }
            50% { opacity: 1; }
        }

        .tag {
            text-align: center;
            color: var(--text-muted);
            font-size: 11px;
            letter-spacing: 3px;
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        h2 {
            text-align: center;
            margin: 0 0 28px;
            color: var(--neon-blue);
            font-family: 'JetBrains Mono', monospace;
            font-weight: 800;
            font-size: 22px;
            letter-spacing: 3px;
            text-transform: uppercase;
            text-shadow: 0 0 6px var(--neon-blue), 0 0 20px var(--neon-glow), 0 0 40px rgba(0,246,255,0.25);
            animation: flicker 4s infinite;
        }

        @keyframes flicker {
            0%, 19%, 21%, 23%, 80%, 100% { opacity: 1; }
            20%, 22% { opacity: 0.6; }
        }

        .form-group { margin-bottom: 22px; }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 11px;
            color: var(--neon-blue-dim);
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        input {
            width: 100%;
            padding: 13px 14px;
            border: 1px solid var(--border-color);
            background: #010812;
            color: var(--neon-blue);
            border-radius: 6px;
            box-sizing: border-box;
            font-size: 14px;
            font-family: 'Share Tech Mono', monospace;
            letter-spacing: 1px;
            outline: none;
            transition: all 0.25s ease;
        }

        input:focus {
            border-color: var(--neon-blue);
            box-shadow: 0 0 4px var(--neon-blue), 0 0 18px var(--neon-glow);
        }

        input::placeholder { color: #274353; }

        button {
            width: 100%;
            padding: 14px;
            background: transparent;
            border: 1px solid var(--neon-blue);
            color: var(--neon-blue);
            font-weight: bold;
            font-family: 'JetBrains Mono', monospace;
            border-radius: 6px;
            cursor: pointer;
            margin-top: 8px;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: all 0.2s ease;
        }

        button:hover {
            background: var(--neon-blue);
            color: #01040a;
            box-shadow: 0 0 10px var(--neon-blue), 0 0 35px var(--neon-glow);
        }

        button:active { transform: scale(0.97); }

        .error, .success {
            padding: 11px;
            border-radius: 6px;
            font-size: 12px;
            margin-bottom: 18px;
            text-align: center;
            letter-spacing: 0.5px;
        }

        .error {
            background: rgba(255, 45, 85, 0.08);
            border: 1px solid var(--error-color);
            color: var(--error-color);
            text-shadow: 0 0 8px rgba(255, 45, 85, 0.5);
        }

        .success {
            background: rgba(0, 255, 157, 0.08);
            border: 1px solid var(--success-color);
            color: var(--success-color);
            text-shadow: 0 0 8px rgba(0, 255, 157, 0.5);
        }

        .back {
            display: block;
            text-align: center;
            margin-top: 24px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 12px;
            letter-spacing: 1.5px;
            transition: color 0.2s;
        }

        .back:hover {
            color: var(--neon-blue);
            text-shadow: 0 0 8px var(--neon-glow);
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="tag">[ ADMIN CONTROL PANEL ]</div>
        <h2>// SECURE_UPDATE</h2>
        <% if (locals.error && error) { %>
            <div class="error">⚠ <%= error %></div>
        <% } %>
        <% if (locals.success && success) { %>
            <div class="success">✔ <%= success %></div>
        <% } %>
        <form action="/admin/password" method="POST">
            <div class="form-group">
                <label>&gt; Current Password</label>
                <input type="password" name="currentPassword" required autocomplete="current-password" placeholder="••••••••">
            </div>
            <div class="form-group">
                <label>&gt; New Password</label>
                <input type="password" name="newPassword" required autocomplete="new-password" placeholder="••••••••">
            </div>
            <button type="submit">Execute Update</button>
        </form>
        <a href="/admin/dashboard" class="back">&lt; Return to Dashboard</a>
    </div>
</body>
</html>
